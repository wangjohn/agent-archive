{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-archive.dev/schemas/issuance-slot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "recipient_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "permission_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "pairing_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "version": {
      "const": 1
    },
    "destination_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_name": {
      "type": "string",
      "minLength": 118,
      "maxLength": 118
    },
    "secret_ref": {
      "type": "string",
      "maxLength": 128
    },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63
    },
    "jurisdiction": {
      "enum": [
        "eu",
        "us",
        "fedramp"
      ]
    },
    "origin": {
      "enum": [
        "fresh",
        "spare",
        "guided"
      ]
    },
    "state": {
      "enum": [
        "creation-intent",
        "secret-intent",
        "spare",
        "reserved",
        "delivery-intent",
        "delivered",
        "own-intent",
        "own",
        "cleanup-pending",
        "deleted"
      ]
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "cleanup_reason": {
      "type": "string",
      "maxLength": 128
    },
    "secret_removal_pending": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "slot_id",
    "recipient_id",
    "issuer_id",
    "destination_id",
    "account_id",
    "bucket",
    "permission_id",
    "provider_name",
    "secret_ref",
    "origin",
    "state",
    "created_at"
  ]
}
