{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wangjohn/agent-archive/schemas/metadata.schema.json",
  "title": "Agent Archive metadata sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "native_session_id", "machine_id", "project_id", "started_at", "captured_at", "metadata_derived_at", "harness", "adapter", "parser", "filter_version", "state", "skill_detection", "counts", "source_bundle"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "native_session_id": {"type": "string", "minLength": 1},
    "machine_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "metadata_derived_at": {"type": "string", "format": "date-time"},
    "harness": {"$ref": "#/$defs/harness"},
    "adapter": {"$ref": "#/$defs/versioned"},
    "parser": {"type": "object", "additionalProperties": false, "required": ["name", "version", "status"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "status": {"enum": ["partial", "failed", "complete"]}}},
    "filter_version": {"type": "string"},
    "state": {"enum": ["active", "idle", "closed", "unknown"]},
    "turn_outcome": {"enum": ["completed", "interrupted", "error", "unknown"]},
    "semantic_conventions": {"type": "object", "additionalProperties": false, "required": ["name", "revision"], "properties": {"name": {"type": "string"}, "revision": {"type": "string"}}},
    "models": {"type": "array", "items": {"type": "object"}},
    "skills_available": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "skills_used": {"type": "array", "items": {"type": "object"}},
    "skill_detection": {"enum": ["observed_none", "partial", "unavailable", "observed"]},
    "counts": {"type": "object", "description": "Every count is optional: an absent count is unknown, never zero. From parser 0.6.0 'turns' counts human prompts (a user record with text or any non-tool-result content), 'messages' counts those prompts plus assistant records, and 'tool_results' counts observed tool results. The token counts are summed from whatever the harness exposed and are absent when it exposed none.", "properties":{"turns":{"type":"integer","minimum":0},"messages":{"type":"integer","minimum":0},"tool_calls":{"type":"integer","minimum":0},"tool_results":{"type":"integer","minimum":0},"explicit_feedback":{"type":"integer","minimum":0},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"cache_read_tokens":{"type":"integer","minimum":0},"cache_write_tokens":{"type":"integer","minimum":0}}},
    "capture_gaps": {"type": "array", "items": {"type": "object"}},
    "source_bundle": {"type": "object", "additionalProperties": false, "required": ["key", "sha256", "compressed_bytes"], "properties": {"key": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "compressed_bytes": {"type": "integer", "minimum": 0}}},
    "parent_session_id": {"type": "string", "minLength": 1},
    "linked_sessions": {"type": "array", "items": {"$ref": "#/$defs/linked_session"}}
  },
  "$defs": {
    "harness": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "mode": {"type": "string"}}},
    "versioned": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "skill": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string"}, "coverage":{"type":"string"}}},
    "linked_session": {"type": "object", "additionalProperties": false, "required": ["session_id", "relationship", "status", "observed_at"], "properties": {"session_id": {"type": "string", "minLength": 1}, "relationship": {"const": "subagent"}, "status": {"enum": ["pending", "published", "unavailable"]}, "observed_at": {"type": "string", "format": "date-time"}}}
  }
}
