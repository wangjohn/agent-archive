{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wangjohn/agent-archive/main/schemas/metadata.schema.json",
  "title": "Agent Archive metadata sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "native_session_id",
    "machine_id",
    "project_id",
    "started_at",
    "captured_at",
    "metadata_derived_at",
    "harness",
    "adapter",
    "parser",
    "filter_version",
    "state",
    "skill_detection",
    "counts",
    "source_bundle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "native_session_id": {
      "type": "string",
      "minLength": 1
    },
    "machine_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_derived_at": {
      "type": "string",
      "format": "date-time"
    },
    "harness": {
      "$ref": "#/$defs/harness"
    },
    "adapter": {
      "$ref": "#/$defs/versioned"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "description": "How far the parser vouches for this metadata. 'complete': the adapter has shown it understands every retained record, and list --complete requires it. 'partial' (the default): the metadata was derived, but the parser does not claim to understand every record, so counts and models may be incomplete. 'failed': the filtered source could not be parsed; only identity, the source reference, and hook-derived lifecycle are filled in, and a later parser version may retry.",
          "enum": [
            "partial",
            "failed",
            "complete"
          ]
        }
      }
    },
    "filter_version": {
      "type": "string"
    },
    "state": {
      "enum": [
        "active",
        "idle",
        "closed",
        "unknown"
      ]
    },
    "turn_outcome": {
      "enum": [
        "completed",
        "interrupted",
        "error",
        "unknown"
      ]
    },
    "semantic_conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "skills_available": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "skills_used": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_use"
      }
    },
    "skill_detection": {
      "enum": [
        "observed_none",
        "partial",
        "unavailable",
        "observed"
      ]
    },
    "counts": {
      "type": "object",
      "description": "Every count is optional: an absent count is unknown, never zero. From parser 0.6.0 'turns' counts human prompts (a user record with text or any non-tool-result content), 'messages' counts those prompts plus assistant records, and 'tool_results' counts observed tool results. From parser 0.7.0 a harness-written user record (isMeta, local-command or shell output, or a slash command no assistant answered) is not a prompt, 'messages' counts distinct assistant message ids (a record without an id counts on its own), and 'user_shell_commands' counts shell commands the person ran directly (Claude Code '!' commands). From parser 0.8.0 a Claude Code compaction summary (a user record marked isCompactSummary) is neither a prompt nor a message, and 'compactions' counts how many times the session was compacted (/compact or auto-compaction), from compact_boundary records or, when none was retained, from compaction summaries; it is present only for Claude Code sessions captured with filter 5 or later. From parser 0.9.0 a harness-written notification (origin.kind 'task-notification') is not a prompt. From parser 0.10.0 Claude Code's '[Request interrupted by user…]' marker is not a prompt, 'tool_calls' no longer counts tool-call shapes found inside another call's arguments, a Cursor text transcript's role sections start only at a header in column 0, and a message Claude Code synthesized itself (model '<synthetic>') names no model and adds no tokens. From parser 0.11.0 a Cursor text transcript's role header is lower case ('user:', not 'User:'), and when its sections are separated by blank lines a role line that does not follow one is content; token totals saturate at 2^53 instead of overflowing. The token counts are summed from whatever the harness exposed, counting only whole numbers from 0 to 2^53 (anything else in a record is ignored), and are absent when it exposed none.",
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_results": {
          "type": "integer",
          "minimum": 0
        },
        "user_shell_commands": {
          "type": "integer",
          "minimum": 0
        },
        "compactions": {
          "type": "integer",
          "minimum": 0
        },
        "explicit_feedback": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capture_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "sha256",
        "compressed_bytes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compressed_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "parent_session_id": {
      "type": "string",
      "minLength": 1
    },
    "linked_sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linked_session"
      }
    },
    "origin": {
      "const": "import",
      "description": "Present only for a session `agent-archive backfill` imported; absent for a hook-captured session. An imported session also carries the capture gap 'imported_without_hook_evidence': it has no lifecycle events, final-response text, or skill inventory."
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this machine imported the session. Present only with origin 'import'."
    },
    "started_at_source": {
      "enum": [
        "hook",
        "transcript",
        "file_created",
        "cursor_composer"
      ],
      "description": "Where started_at came from: 'hook' when a hook observed the start, 'transcript' the earliest native record, 'file_created' the transcript file's birth time (Cursor transcripts, whose records have no timestamps), and 'cursor_composer' the chat's creation time in Cursor's database (a chat imported from it). Present only with origin 'import'."
    }
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "versioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "coverage": {
          "enum": [
            "eligible",
            "discovered",
            "installed_only"
          ]
        }
      }
    },
    "linked_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "relationship",
        "status",
        "observed_at"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "const": "subagent"
        },
        "status": {
          "enum": [
            "pending",
            "published",
            "unavailable"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributes",
        "source",
        "response_model_status"
      ],
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "OpenTelemetry gen_ai.* attributes (see semantic_conventions) and agent_archive.* local extensions."
        },
        "source": {
          "enum": [
            "native_transcript",
            "hook"
          ]
        },
        "response_model_status": {
          "enum": [
            "not_exposed",
            "observed"
          ]
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skill_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string"
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "enum": [
            "native_invocation",
            "skill_read_inference"
          ]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/gap_code"
        },
        "record": {
          "type": "integer",
          "minimum": 1
        },
        "detail": {
          "type": "string",
          "description": "Archive-authored description of the omission. Never a transcript value. From filter version 3 the single unknown_field_omitted gap carries the distinct omitted key names, sorted and capped, as 'omitted keys: a, b, c'."
        }
      }
    },
    "gap_code": {
      "description": "An archive-authored reason. The enum lists every code this version writes (internal/archive CaptureGapCodes; docs/agent-archive-privacy.md says what each means). A reader must accept any other lowercase code, which an older or newer writer may use.",
      "anyOf": [
        {
          "enum": [
            "binary_content_omitted",
            "content_truncated",
            "cursor_blob_content_unavailable",
            "cursor_bubble_id_mismatch",
            "cursor_bubble_missing",
            "cursor_chat_rewritten",
            "cursor_context_omitted",
            "cursor_incomplete_tail_omitted",
            "cursor_inline_conversation_omitted",
            "cursor_message_type_unknown",
            "cursor_tool_argument_omitted",
            "hidden_instruction_omitted",
            "hidden_or_unknown_nested_content_omitted",
            "imported_without_hook_evidence",
            "incomplete_or_invalid_record",
            "record_without_allowed_fields_omitted",
            "sensitive_content_redacted",
            "sensitive_or_hidden_field_omitted",
            "subagent_final_not_reconciled",
            "subagent_identity_unavailable",
            "supplemental_evidence_omitted",
            "text_structure_partial",
            "unknown_field_omitted",
            "unknown_record_type",
            "unsupported_value_omitted"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      ]
    }
  }
}
